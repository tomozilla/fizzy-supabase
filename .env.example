# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Web push (generate your own with a P-256 keypair; the private half goes to
# the Edge Function as a secret, never here)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# WebAuthn / passkeys — must match the origin the app is served from.
# Local dev/tests use localhost; production uses the deployed host (see
# docs/testing.md for how these are supplied to `supabase config push`).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGINS=http://localhost:3000,http://localhost:3100,http://127.0.0.1:3000

# Passkeys are a project-level Supabase Auth setting that `supabase config
# push` doesn't manage — enable them on the project first (dashboard →
# Authentication), then flip this on so the UI appears.
NEXT_PUBLIC_PASSKEYS_ENABLED=false
